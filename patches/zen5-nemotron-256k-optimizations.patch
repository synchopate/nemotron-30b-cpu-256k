+struct llama_modchip_shm_t {
+    uint32_t magic;            // 0x4D4F4443 ("MODC")
+    uint32_t version;          // 1
+    int32_t  kv_l3_window;     // L3 hot window tokens (0 = disable KV NTA)
+    int32_t  attn_window;      // SWA window tokens (0 = full global attention)
+    int32_t  attn_sinks;       // Attention sinks (default 16)
+    int32_t  swa_stride;       // 0/1 = all layers SWA; 4 = 3:1 Interleaved SWA (keep every 4th layer global)
