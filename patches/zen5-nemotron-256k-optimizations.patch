+    int32_t  rc_cert_d1;       // Step 1 certainty gate (92 strict / 88 balanced)
+    int32_t  rc_cert_d2;       // Step 2 certainty gate (96 strict / 94 balanced)
+    int32_t  moe_top_k;        // Active MoE Top-K
+};
