+    while (*s) {
+        if (*s >= '0' && *s <= '9') {
+            int v = 0;
+            while (*s >= '0' && *s <= '9') {
+                v = v * 10 + (*s - '0');
+                s++;
+            }
+            last_num = v;
+        } else {
+            s++;
+        }
+    }
+    return last_num;
